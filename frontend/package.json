{
    "name": "@mutablelogic/go-auth",
    "version": "0.0.0",
    "description": "go-auth's web UI modules, Credentials, Certificates and LDAP, which an app can include, and the auth server's app",
    "license": "Apache-2.0",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mutablelogic/go-auth.git",
        "directory": "frontend"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "files": [
        "dist"
    ],
    "exports": {
        "./credential": {
            "types": "./dist/credential/index.d.ts",
            "import": "./dist/credential/index.js"
        },
        "./credential/view": {
            "types": "./dist/credential/view.d.ts",
            "import": "./dist/credential/view.js"
        },
        "./cert": {
            "types": "./dist/cert/index.d.ts",
            "import": "./dist/cert/index.js"
        },
        "./cert/view": {
            "types": "./dist/cert/view.d.ts",
            "import": "./dist/cert/view.js"
        },
        "./ldap": {
            "types": "./dist/ldap/index.d.ts",
            "import": "./dist/ldap/index.js"
        },
        "./ldap/view": {
            "types": "./dist/ldap/view.d.ts",
            "import": "./dist/ldap/view.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "build-app": "node app/build.js",
        "check": "tsc -p tsconfig.json",
        "test": "node --test 'test/**/*.test.ts'"
    },
    "engines": {
        "node": ">=22.18"
    },
    "peerDependencies": {
        "@carbon/icons": "^11.92.0",
        "@carbon/web-components": "^2.67.0",
        "@mutablelogic/go-server": "^1.8.10",
        "lit": "^3.3.3"
    },
    "devDependencies": {
        "@carbon/icons": "^11.92.0",
        "@carbon/styles": "^1.119.0",
        "@carbon/web-components": "^2.67.0",
        "@ibm/plex-mono": "^2.5.0",
        "@ibm/plex-sans": "^1.1.0",
        "@mutablelogic/go-server": "^1.8.11",
        "@types/node": "^24.19.2",
        "esbuild": "^0.25.12",
        "lit": "^3.3.3",
        "typescript": "^5.9.3"
    }
}
